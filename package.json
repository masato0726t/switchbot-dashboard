{
  "name": "switchbot-dashboard",
  "version": "1.0.0",
  "description": "SwitchBot デバイスの温度・湿度・CO2 を可視化する Web ダッシュボード",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.cjs",
    "build:server": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs switchbot-dashboard"
  },
  "dependencies": {
    "close-with-grace": "^2.5.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "http-errors": "^2.0.1",
    "kysely": "^0.29.4",
    "lru-cache": "^11.5.2",
    "mysql2": "^3.22.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testcontainers/mysql": "^12.0.4",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-boundaries": "^5.4.0",
    "globals": "^17.7.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  }
}
