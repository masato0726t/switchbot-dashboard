{
  "name": "switchbot-dashboard",
  "version": "1.0.0",
  "description": "SwitchBot デバイスの温度・湿度・CO2 を可視化する Web ダッシュボード",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "lint": "eslint .",
    "test": "node --test",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs switchbot-dashboard"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "mysql2": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.7.0"
  }
