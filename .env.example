# 必須。1つでも欠けると起動時にエラーで停止する。
DB_HOST=192.168.150.222
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=switchbot_db

# 任意（既定値あり）。設定する場合は下記の制約を満たす必要がある。
# 空文字・0・数値でない値を書くと、黙って既定値に倒れずに起動が失敗する。
# 「設定したはずなのに効いていない」という気づきにくい障害を防ぐため。
DB_PORT=3306         # 1 以上の整数
PORT=3000            # 1 以上の整数
DB_POOL_LIMIT=10     # 1 以上の整数
TOTALS_TTL_MS=60000  # 1 以上の整数（ミリ秒）
LOG_LEVEL=info       # fatal / error / warn / info / debug / trace

# development / production / test のいずれか（既定 development）。
# 本番では必ず production を指定すること。development のままだと
# pino-pretty の整形用ワーカースレッドが本番でも起動してしまう（README の
# 「起動」節を参照）。pm2 経由（ecosystem.config.cjs）なら自動で設定される。
NODE_ENV=development
